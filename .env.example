# .env.example
PORT=3000
CORS_ORIGIN=http://localhost:5173

# MySQL (Docker, see compose.yaml)
MYSQL_ROOT_PASSWORD=change-me-root
DATABASE_PASSWORD=change-me-app

DATABASE_URL="mysql://task_api:change-me-app@127.0.0.1:3307/task_api"
SHADOW_DATABASE_URL="mysql://task_api:change-me-app@127.0.0.1:3307/task_api_shadow"

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_USER=task_api
DATABASE_NAME=task_api

# Auth (generate the secret with: openssl rand -hex 32)
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

